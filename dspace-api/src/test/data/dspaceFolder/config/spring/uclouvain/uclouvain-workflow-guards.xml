<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                  http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
                  http://www.springframework.org/schema/context
                  http://www.springframework.org/schema/context/spring-context-2.5.xsd">

    <context:annotation-config /> <!-- allows us to use spring annotations in beans -->

    <!-- ////////////////////////////////////////// -->
    <!-- WORKFLOW START GUARDS -->
    <!-- ////////////////////////////////////////// -->
    <!-- Same declaration as `dspace/config/spring/uclouvain/uclouvain-workflow-guards.xml`, which
         this file shadows in the test environment (see `src/main/assembly/testEnvironment.xml`).
         The guard is inert for the whole test suite: `local.cfg` disables the mail server without
         any fixed recipient, so no mail is ever sent. A test that wants the guard to bite sets
         `mail.server.fixedRecipient`. -->
    <bean id="mailServerAliveGuard" class="org.dspace.uclouvain.xmlworkflow.guards.MailServerAliveGuard"/>
</beans>
