<dspace-dc-types>
    <dspace-header>
        <title>UCLouvain specific metadata definitions</title>
        <contributor.author>Renaud Michotte</contributor.author>
        <contributor.editor>Michaël Pourbaix</contributor.editor>
    </dspace-header>
    <!-- DUBLIN CORE SCHEMA -->
    <dc-type>
        <schema>dc</schema>
        <element>language</element>
        <qualifier>iso-639-2</qualifier>
        <scope_note>ISO 639-2 code language</scope_note>
    </dc-type>
    <dc-type>
        <schema>dc</schema>
        <element>description</element>
        <qualifier>tag</qualifier>
        <scope_note>Custom tag placed on a publication [ie: accepted, submitted, ...]</scope_note>
    </dc-type>
    <dc-type>
        <schema>dc</schema>
        <element>identifier</element>
        <qualifier>fedora</qualifier>
        <scope_note>To store original FedoraCommons PID</scope_note>
    </dc-type>
    <!-- AUTHORS SCHEMA -->
    <dc-schema>
        <name>authors</name>
        <namespace>https://uclouvain.be/ontology/persons</namespace>
    </dc-schema>
    <dc-type>
        <schema>authors</schema>
        <element>email</element>
        <qualifier />
        <scope_note>Author email</scope_note>
    </dc-type>
    <dc-type>
        <schema>authors</schema>
        <element>identifier</element>
        <qualifier>fgs</qualifier>
        <scope_note>UCLouvain global ID (aka FGS number)</scope_note>
    </dc-type>
    <dc-type>
        <schema>authors</schema>
        <element>identifier</element>
        <qualifier>noma</qualifier>
        <scope_note>UCLouvain specific student ID</scope_note>
    </dc-type>
    <dc-type>
        <schema>authors</schema>
        <element>identifier</element>
        <qualifier>orcid</qualifier>
        <scope_note>Orcid ID</scope_note>
    </dc-type>
    <dc-type>
        <schema>authors</schema>
        <element>institution</element>
        <qualifier>code</qualifier>
        <scope_note>Author institution code at the publication datetime (i.e. 'UCLouvain')</scope_note>
    </dc-type>
    <dc-type>
        <schema>authors</schema>
        <element>institution</element>
        <qualifier>name</qualifier>
        <scope_note>Author institution full-name at the publication datetime (i.e. 'Université
            catholique de Louvain')</scope_note>
    </dc-type>
    <dc-type>
        <schema>authors</schema>
        <element>role</element>
        <qualifier />
        <scope_note>Author role in this publication</scope_note>
    </dc-type>
    <!-- FEDORA SCHEMA -->
    <dc-schema>
        <name>fedora</name>
        <namespace>https://fedora.lyrasis.org/resources/schema</namespace>
    </dc-schema>
    <dc-type>
        <schema>fedora</schema>
        <element>pid</element>
        <scope_note>FedoraCommons object pid</scope_note>
    </dc-type>
    <dc-type>
        <schema>fedora</schema>
        <element>contentmodels</element>
        <scope_note>FedoraCommons object content model</scope_note>
    </dc-type>
</dspace-dc-types>