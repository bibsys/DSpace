<dspace-dc-types>
    <dspace-header>
        <title>UCLouvain specific metadata definitions</title>
        <contributor.author>Renaud Michotte</contributor.author>
        <contributor.editor>Michaël Pourbaix</contributor.editor>
    </dspace-header>
    <!-- DUBLIN CORE SCHEMA -->
    <dc-type>
        <schema>dc</schema>
        <element>language</element>
        <qualifier>iso-639-2</qualifier>
        <scope_note>ISO 639-2 code language</scope_note>
    </dc-type>
    <dc-type>
        <schema>dc</schema>
        <element>description</element>
        <qualifier>tag</qualifier>
        <scope_note>Custom tag placed on a publication [ie: accepted, submitted, ...]</scope_note>
    </dc-type>
    <dc-type>
        <schema>dc</schema>
        <element>identifier</element>
        <qualifier>legacyOER</qualifier>
        <scope_note>To store original oer ID</scope_note>
    </dc-type>
    <dc-type>
        <schema>dc</schema>
        <element>identifier</element>
        <qualifier>legacyUri</qualifier>
        <scope_note>To store original handle uri</scope_note>
    </dc-type>
    <!-- AUTHORS SCHEMA -->
    <dc-schema>
        <name>authors</name>
        <namespace>https://uclouvain.be/ontology/authors</namespace>
    </dc-schema>
    <dc-type>
        <schema>authors</schema>
        <element>email</element>
        <qualifier>official</qualifier>
        <scope_note>Author official email</scope_note>
    </dc-type>
    <!-- PUBLICATION SCHEMA -->
    <dc-schema>
        <name>publication</name>
        <namespace>https://uclouvain.be/ontology/publication</namespace>
    </dc-schema>
    <!-- COLLECTIONS ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <dc-type>
        <schema>publication</schema>
        <element>collection</element>
        <qualifier>name</qualifier>
        <scope_note>To specify the collection name to which the publication belongs</scope_note>
    </dc-type>
    <!-- LOM SCHEMA -->
    <dc-schema>
        <name>lom</name>
        <namespace>http://ltsc.ieee.org/xsd/LOM</namespace>
    </dc-schema>
    <dc-type>
        <schema>lom</schema>
        <element>educational</element>
        <qualifier>typicalAgeRange</qualifier>
        <scope_note>The typical expected age range</scope_note>
    </dc-type>
    <!-- TAG SCHEMA -->
    <dc-schema>
        <name>tag</name>
        <namespace>https://uclouvain.be/ontology/tags</namespace>
    </dc-schema>
    <dc-type>
        <schema>tag</schema>
        <element>certified</element>
        <scope_note>Specify the object is certified by a manager user</scope_note>
    </dc-type>
</dspace-dc-types>