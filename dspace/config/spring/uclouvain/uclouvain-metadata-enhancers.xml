<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                  http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
                  http://www.springframework.org/schema/context
                  http://www.springframework.org/schema/context/spring-context-2.5.xsd
                  http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd"
       xmlns:util="http://www.springframework.org/schema/util">
    <context:annotation-config /> <!-- allows us to use spring annotations in beans -->
    
    <!-- Authority Based Metadata enhancers -->
    <!-- 
        This functionality is used to update configured metadata to be in sync with a source.
        The source is another item that holds the correct value for the metadata.
        For example, an author has a name (the source) and this can be also stored in a publication (the target).
        So the source is the item that olds the right data value and the target the item to update accordingly.
         
        @author Michaël Pourbaix <michael.pourbaix@uclouvain.be>
    -->
    <bean class="org.dspace.uclouvain.itemEnhancer.poller.UCLouvainItemEnhancerUpdatePoller"/>
    <bean name="uclouvainItemEnhancerDAO" class="org.dspace.uclouvain.itemEnhancer.dao.UCLouvainItemEnhancerDAOImpl"/>
    <bean name="uclouvainItemEnhancerService" class="org.dspace.uclouvain.itemEnhancer.UCLouvainItemEnhancerServiceImpl">
        <property name="enhancers">
            <util:list>
                <!-- Put enhancer configuration bean here -->
                <ref bean="publicationAuthorEnhancer"/>
                <ref bean="publicationAuthorEmailEnhancer"/>
                <ref bean="publicationAuthorORCIDEnhancer"/>
                <ref bean="publicationInstitutionEnhancer"/>
                <ref bean="publicationDepartmentEnhancer"/>
                <ref bean="publicationJournalTitleEnhancer"/>
                <ref bean="publicationJournalISSNEnhancer"/>
                <ref bean="publicationJournalEISSNEnhancer"/>
                <ref bean="publicationJournalPeerReviewedEnhancer"/>
                <ref bean="publicationJournalPublisherEnhancer"/>
                <ref bean="publicationJournalPublisherLocationEnhancer"/>
                <ref bean="personInstitutionEnhancer"/>
                <ref bean="personDepartmentEnhancer"/>
                <ref bean="affiliationParentEnhancer"/>
            </util:list>
        </property>
    </bean>
    <!-- Enhancers configuration -->
    <bean name="publicationAuthorEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Person"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.title</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>dc.contributor.author</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationAuthorEmailEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Person"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>person.email.official</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>authors.email</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationAuthorORCIDEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Person"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>person.identifier.orcid</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>authors.identifier.orcid</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationInstitutionEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="OrgUnit"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>oairecerif.acronym</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>oairecerif.affiliation.orgunit</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationDepartmentEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="OrgUnit"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.title</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>oairecerif.affiliation.orgunitDepartment</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationJournalTitleEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Journal"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.title</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>dc.relation.journal</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationJournalISSNEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Journal"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.identifier.issn</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>publication.serial.issn</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationJournalEISSNEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Journal"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.identifier.eissn</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>publication.serial.eissn</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationJournalPeerReviewedEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Journal"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>journal.peerReviewed</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>publication.serial.peerReviewed</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationJournalPublisherEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Journal"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.publisher</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>publication.editor.name</value>
            </util:list>
        </property>
    </bean>
    <bean name="publicationJournalPublisherLocationEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="Journal"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.publisher.location</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Publication"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>publication.editor.location</value>
            </util:list>
        </property>
    </bean>
    <bean name="personInstitutionEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="OrgUnit"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>oairecerif.acronym</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Person"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>person.affiliation.institution</value>
            </util:list>
        </property>
    </bean>
    <bean name="personDepartmentEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="OrgUnit"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.title</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="Person"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>person.affiliation.department</value>
            </util:list>
        </property>
    </bean>
    <bean name="affiliationParentEnhancer" class="org.dspace.uclouvain.itemEnhancer.enhancers.ItemEnhancerConfiguration">
        <property name="sourceEntityType" value="OrgUnit"/>
        <property name="sourceMetadataFields">
            <util:list>
                <value>dc.title</value>
            </util:list>
        </property>
        <property name="targetEntityType" value="OrgUnit"/>
        <property name="targetMetadataFields">
            <util:list>
                <value>organization.parentOrganization</value>
            </util:list>
        </property>
    </bean>
</beans>