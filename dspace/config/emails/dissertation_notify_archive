## Email sent to a DSpace User when his submission has be validated and entered the archive
## This email comes with an attachment: an attestation that confirms the submission.
## Parameters:
##    {0} Date and time
##    {1} The handle of the publication
##    {2} Information about the submission (title, abstract...) in french
##    {3} Information about the submission (title, abstract...) in english
##    {4} List of attached files. Each row is a tuple of filename and file access type
<html>
  <head>
    <meta charset="UTF-8">
    <link href='https://fonts.googleapis.com/css?family=Montserrat' rel='stylesheet':>
    <style>
      body {
        font-family: 'Montserrat', arial, sans-serif;
        font-size: 12px;
      }
      h1 {
        display: block;
        text-align: center;
        background-color: rgb(74, 79, 85);
        color: white;
        padding: 10px;
        margin-top: 0;
      }
      .language {
        font-style: italic;
        width: 100%;
        text-align: center;
      }
      .timestamp {
        text-align:right;
      }
      .heading {
        text-decoration: underline;
      }
      .metadata-table th, .metadata-table td, .metadata-table tr {
        margin: 0;
      }
      .metadata-table th {
        width: 25%;
        min-width: 150px;
        font-weight: bold;
        background-color: #EEE;
        text-align: left;
        padding-right: 10px;
      }
    </style>
  </head>
  <body>
    <p style="margin:20px">
      <img height="80px" src="data:image/png;base64,">
    </p>
    <h1>DIAL.pr</h1>
    <p class="timestamp">${params[0]}</p>
    <div class="language" style="border-bottom:1px solid #777; color: #777;">
      Version française (English version below)
    </div>
    <p>Madame/Monsieur,</p>
    <p>
      Suite à la réussite de votre défense publique, votre thèse est diffusée sur DIAL.pr, et disponible à l'adresse ci-dessous.<br/>
    </p>
    <h4 class="heading">Informations relatives à la thèse</h4>
    <table class="metadata-table" style="border: 1px solid #777">
      <tbody>
        #foreach ($mapEntry in $params[2].entrySet())
          <tr>
            <th style="border-right: 1px solid #777">$mapEntry.key</th>
            <td>$mapEntry.value</td>
          </tr>
        #end
        <tr>
          <th style="border-right: 1px solid #777">Lien vers la thèse</th>
          <td>
            <a href="${params[1]}">${params[1]}</a>
          </td>
        </tr>
      </tbody>
    </table>
    #if (!$params[4].isEmpty())
      <h4 class="heading">Fichiers attachés</h4>
      <ul>
        #foreach ($attached_file in $params[4])
          <li>$attached_file[0] ($attached_file[1])</li>
        #end
      </ul>
    #end

    <p>L'équipe ${config.get('dspace.name')}.</p>
    <br/>
    <p>Vous avez une question ? <a href="mailto:dial@uclouvain.be">Contactez l'équipe DIAL</a> ou <a href="https://www.uclouvain.be/fr/bibliotheques/dial.pr">consultez les guides et tutoriels</a></p>

    <div class="language" style="border-bottom:1px solid #777; color: #777;">English version</div>
    <p>Dear Sir/Madam,</p>
    <p>
      Following the success of your public defense, your dissertation is now available on DIAL.pr, following the ink below.<br/>
    </p>
    <h4 class="heading">Dissertation data</h4>
    <table class="metadata-table" style="border: 1px solid #777">
      <tbody>
        #foreach ($mapEntry in $params[3].entrySet())
          <tr>
            <th style="border-right: 1px solid #777">$mapEntry.key</th>
            <td>$mapEntry.value</td>
          </tr>
        #end
        <tr>
          <th style="border-right: 1px solid #777">Link to dissertation</th>
          <td>
            <a href="${params[1]}">${params[1]}</a>
          </td>
        </tr>
      </tbody>
    </table>
    #if (!$params[4].isEmpty())
      <h4 class="heading">Attached files</h4>
      <ul>
        #foreach ($attached_file in $params[4])
          <li>$attached_file[0] ($attached_file[1])</li>
        #end
      </ul>
    #end

    <p>The ${config.get('dspace.name')} team.</p>
    <br/>
    <p>Do you have a question ? <a href="mailto:dial@uclouvain.be">Contact the DIAL team</a> or <a href="https://www.uclouvain.be/en/university-libraries/dial.pr">read the user guides and tutorials</a></p>
  </body>
</html>